  3. }

. collapse (sum) borrowing_volume0 borrowing_volume1 lending_volume0 lending_volume1 gross0 gross1 dress_* n_dealers = active0, by(fund_id quarte
> r)

. gen exposure_borrowing = dress_borrowing_volume0/borrowing_volume0
