  2.         reghdfe y`c' exposure exposure_dose dose, a(quarter) vce(cluster main_dealer)
  3.         matrix slopes[`i', 1] = _b[exposure]
  4.         matrix slopes[`i', 2] = _se[exposure]
  5.         matrix slopes[`i', 3] = _b[exposure_dose]
  6.         matrix slopes[`i', 4] = _se[exposure_dose]
  7.         local ++i
  8. }
