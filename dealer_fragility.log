. gen entry_borrowing = borrowing_flow0 == 0 & borrowing_flow1 > 0

. gen exit_lending = lending_flow0 > 0 & lending_flow1 == 0

. gen entry_lending = lending_flow0 == 0 & lending_flow1 > 0

. 
