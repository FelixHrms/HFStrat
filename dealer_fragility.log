. 
. use `country_shocks', clear

. cross using `dealer_nat'

. gen home_shock = 0

. gen home_shock_tail = 0

. foreach c in DE FR IT ES {
  2.         replace home_shock = shock_cum`c' if nationality == "`c'"
  3.         replace home_shock_tail = tail_cum`c' if nationality == "`c'"
  4. }
