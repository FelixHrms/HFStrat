. **# Country-specific CDS shocks
. * daily log changes, leave-one-out demeaned across the other three countries,
. * rescaled to bp by the lagged own level, cumulated over a 20-day window
. 
. tempfile cds_all

. local first = 1

. foreach c in Germany France Italy Spain {
  2.         import delimited "$key\\`c'_CDS.csv", varnames(1) clear
  3.         capture drop v3
  4.         gen country = cond("`c'"=="Germany","DE", cond("`c'"=="France","FR", cond("`c'"=="Italy","IT","ES")))
  5.         if `first' == 0 append using `cds_all'
  6.         local first = 0
  7.         save `cds_all', replace
  8. }
