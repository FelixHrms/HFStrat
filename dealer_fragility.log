. 
. collapse (sum) borrowing_flow0 borrowing_flow1 lending_flow0 lending_flow1 (max) treated, by(fund_id dealer_id country event_id)

. gen dlog_borrowing = log(borrowing_flow1) - log(borrowing_flow0)
