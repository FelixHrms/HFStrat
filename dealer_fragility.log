. **# CDS country-specific shocks
. 
. tempfile cds

. local first = 1

. foreach c in Germany France Italy Spain {
  2.         import delimited "$key\\`c'_CDS.csv", varnames(1) clear
  3.         capture drop v3
  4.         gen country = cond("`c'"=="Germany","DE", cond("`c'"=="France","FR", cond("`c'
> "=="Italy","IT","ES")))
  5.         if `first' == 0 append using `cds'
  6.         local first = 0
  7.         save `cds', replace
  8. }
